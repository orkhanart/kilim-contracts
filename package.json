{
  "name": "kilim-contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Kilim glyphs, the 1/1 and the native ETH auction contracts",
  "scripts": {
    "build": "node scripts/verify-upstream.mjs && node scripts/forge.mjs build --sizes --skip test --skip script",
    "test": "node scripts/verify-upstream.mjs && node scripts/forge.mjs test -vv && node --test --test-concurrency=1 \"../site/test/*.test.mjs\"",
    "test:contracts": "node scripts/verify-upstream.mjs && node scripts/forge.mjs test -vv",
    "test:site": "node scripts/forge.mjs build && node --test --test-concurrency=1 \"../site/test/*.test.mjs\"",
    "test:ci": "node scripts/verify-upstream.mjs && FOUNDRY_PROFILE=ci node scripts/forge.mjs test -vv && node --test --test-concurrency=1 \"../site/test/*.test.mjs\"",
    "test:page": "node --test ../onchain/test/page.test.mjs",
    "test:pack": "python3 -m unittest discover -s ../onchain/test -p 'test_*.py'",
    "pack:glyphs": "python3 ../onchain/pack_glyphs.py ../research/motifs/curate/living-language-v3/index.html ../onchain/build-glyphs",
    "pack:page": "python3 ../onchain/pack_page.py",
    "deploy:dry": "KILIM_DEPLOY_CONFIG=deploy/local.json node scripts/forge.mjs script script/DeployKilim.s.sol --sig 'run()'",
    "coverage": "node scripts/forge.mjs coverage --report lcov --report summary",
    "fmt": "node scripts/forge.mjs fmt --check",
    "audit:static": "node scripts/slither.mjs",
    "artifacts": "node scripts/artifacts.mjs",
    "verify:upstream": "node scripts/verify-upstream.mjs",
    "dev:chain": "node scripts/dev-chain.mjs",
    "walkthrough": "node scripts/forge.mjs build && node scripts/walkthrough.mjs",
    "site-config": "node scripts/site-config.mjs",
    "site:build": "python3 ../site/build.py",
    "site:orkhanart": "python3 ../site/build.py --target orkhanart",
    "site:sync-orkhanart": "python3 ../site/tools/sync_orkhanart.py"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@foundry-rs/forge": "1.7.1",
    "solc": "0.8.37"
  },
  "packageManager": "pnpm@11.19.0"
}
